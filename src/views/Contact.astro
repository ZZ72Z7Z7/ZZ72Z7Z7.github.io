---
import Base from '../layouts/Base.astro';
import { t, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
---
<Base title={ui.menu.contact} lang={lang} path="/contact/" section="contact">
  <h1 class="visually-hidden">{ui.menu.contact}</h1>
  <h2 class="h3 contact-head contact-first">{ui.form.writeHeading}</h2>
  <p class="contact-email"><a href="mailto:giovanni.fusetti@helikos.com">giovanni.fusetti@helikos.com</a></p>

  <h2 class="h3 contact-head">{ui.form.mailingHeading}</h2>
  <!-- Placeholder: wired to Mailchimp later. -->
  <form action="#" method="post" onsubmit="return false">
    <input type="email" name="email" autocomplete="email" placeholder={ui.form.email} aria-label={ui.form.email} required />
    <button type="submit" disabled>{ui.form.subscribe}</button>
  </form>
</Base>
