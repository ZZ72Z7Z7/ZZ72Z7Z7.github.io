---
import { t, type Lang } from '../i18n/ui';
interface Props { lang: Lang; label: string }
const { lang, label } = Astro.props;
const ui = t(lang);
---
<dialog class="lightbox" aria-label={label} data-of={ui.lightboxOf}>
  <button type="button" class="lb-close" aria-label={ui.lightboxClose}>
    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
  </button>
  <button type="button" class="lb-prev" aria-label={ui.lightboxPrev}>
    <svg viewBox="0 0 24 24" width="32" height="32" aria-hidden="true"><path d="M15 4l-8 8 8 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </button>
  <figure class="lb-figure">
    <img class="lb-img" src="" alt="" />
    <figcaption class="lb-caption"></figcaption>
    <p class="lb-count" aria-live="polite"></p>
  </figure>
  <button type="button" class="lb-next" aria-label={ui.lightboxNext}>
    <svg viewBox="0 0 24 24" width="32" height="32" aria-hidden="true"><path d="M9 4l8 8-8 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </button>
</dialog>
