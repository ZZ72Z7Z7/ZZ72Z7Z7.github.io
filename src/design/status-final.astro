---
// Design review page: final status chip demo, one example per layout. Local only, never published.
import Base from '../layouts/Base.astro';
const open = { key: 'open', label: 'Open', text: 'Applications close April 30', dates: 'July 12 - 17, 2027', place: 'Boulder, Colorado, USA', title: 'Red Nose Intensive' };
const wait = { key: 'waitlist', label: 'Waitlist', text: '', dates: 'August 23 - 28, 2027', place: 'Melbourne, Victoria, Australia', title: 'The Tao of Clown' };
const tagline = 'A short tagline for the workshop';
---
<Base title="Status chip final demo" lang="en" path="/design/status-final/" noindex wide>
  <h1>Status chip demo</h1>
  <p>One example per layout. Demo only; nothing is applied to the site.</p>

  <h2>Desktop</h2>
  <div class="pair">
    <div class="col">
      <h3>Index</h3>
      <ul class="desk one">
        <li class="card">
          <img src="/images/hero.jpg" alt="" class="thumb" />
          <div class="txt">
            <p class="ttl">{open.title}</p>
            <p class="dates">{open.dates}</p>
            <p class="place">{open.place}</p>
            <p class={`st-row st-${open.key}`}><span class="st">{open.label}</span></p>
            <p class="tag gap">{tagline}</p>
            <p class="acts"><a href="#" class="b">DETAILS</a></p>
          </div>
        </li>
      </ul>
    </div>
    <div class="col">
      <h3>Details</h3>
      <div class="detail single">
        <p class="d-title">{open.title}</p>
        <p class="dates">{open.dates}</p>
        <p class="place">{open.place}</p>
        <p class={`st-row st-${open.key}`}><span class="st">{open.label}</span><em class="st-note">{open.text}</em></p>
        <img src="/images/hero.jpg" alt="" class="wide" />
      </div>
    </div>
  </div>

  <h2>Mobile (375px)</h2>
  <div class="pair">
    <div class="col narrow">
      <h3>Index</h3>
      <div class="phone">
        <p class="ttl">{wait.title}</p>
        <p class="dates">{wait.dates}</p>
        <p class="place">{wait.place}</p>
        <p class={`st-row st-${wait.key}`}><span class="st">{wait.label}</span></p>
        <img src="/images/hero.jpg" alt="" class="pic" />
        <p class="tag">{tagline}</p>
        <p class="acts"><a href="#" class="b">DETAILS</a></p>
      </div>
    </div>
    <div class="col narrow">
      <h3>Details</h3>
      <div class="phone">
        <p class="d-title">{wait.title}</p>
        <p class="dates">{wait.dates}</p>
        <p class="place">{wait.place}</p>
        <p class={`st-row st-${wait.key}`}><span class="st">{wait.label}</span>{wait.text && <em class="st-note">{wait.text}</em>}</p>
        <img src="/images/hero.jpg" alt="" class="pic" />
      </div>
    </div>
  </div>
</Base>

<style>
  p { margin: 0; }
  .detail .st-row, .phone .st-row:has(.st-note) { flex-direction: column; align-items: flex-start; gap: .5rem; }
  .detail .wide, .phone .st-row:has(.st-note) + .pic { margin-top: 1.25rem; }
  h2 { margin-top: 2.5rem; }
  .desk { display: grid; grid-template-columns: repeat(auto-fit, minmax(24rem, 1fr)); gap: 2rem 1.5rem; list-style: none; padding: 0; margin: 0; }
  .card { display: grid; grid-template-columns: 40% 1fr; gap: 1rem; align-items: stretch; list-style: none; }
  .txt { display: flex; flex-direction: column; align-items: flex-start; }
  .thumb { width: 100%; aspect-ratio: 4/3; object-fit: cover; align-self: start; }
  .phones { display: flex; flex-wrap: wrap; gap: 1.5rem; }
  .phone { width: 375px; max-width: 100%; border: 1px solid var(--line); padding: 20px; }
  .dgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(24rem, 1fr)); gap: 1.5rem; }
  .detail { border: 1px solid var(--line); padding: 1rem; }
  .pic { width: 100%; aspect-ratio: 4/3; object-fit: cover; margin: .6rem 0; }
  .wide { width: 100%; height: 8rem; object-fit: cover; margin-top: .6rem; }
  .dates { font-weight: 700; font-size: var(--p2-size); }
  .place { font-size: var(--p1-size); }
  .ttl, .d-title { font-weight: 700; font-size: 1.5rem; margin: .15rem 0; }
  .tag { font-style: italic; color: var(--muted); font-size: var(--p2-size); }
  .card .st-row { margin-bottom: 0; }
  .tag.gap { margin: auto 0; padding: 1.25rem 0; }
  .st-pending { --c: #5f5f5f; }
  .st-open { --c: #1a6b2f; }
  .st-waitlist { --c: #0b5cad; }
  .st-closed { --c: #111; }
  .st-row { display: flex; flex-wrap: wrap; align-items: center; gap: .3rem .6rem; margin: .6rem 0; }
  .st { display: inline-block; padding: .3rem .85rem; color: #fff; background: var(--c); font-size: var(--p3-size); font-weight: 600; line-height: 1.3; text-transform: uppercase; letter-spacing: .04em; }
  .st-note { font-size: var(--p2-size); color: var(--muted); }
  .acts { margin-top: 0; padding-top: 0; }
  .phone .acts { margin-top: 0; padding-top: 1rem; }
  .b { display: inline-block; padding: .55rem 1.1rem; font-size: var(--p2-size); font-weight: 600; letter-spacing: .04em; text-decoration: none; background: var(--red-text); color: #fff; }
  .b:hover { background: #8a0000; }
  .pair { display: flex; flex-wrap: wrap; gap: 2rem; align-items: flex-start; }
  .pair > .col { flex: 1 1 26rem; }
  .pair > .col.narrow { flex: 0 0 375px; max-width: 100%; }
  .detail.single { max-width: 40rem; }
</style>
