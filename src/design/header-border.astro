---
// Design review page: ways to give the header a visible bottom edge. Local only, never built.
// Each frame loads the real Workshops page and injects the option's CSS into it.
import Base from '../layouts/Base.astro';
const options = [
  { id: 'none', name: 'Now · no border', text: 'For comparison.', css: '' },
  { id: 'a', name: 'A · Thin light-grey line', text: '1px #ddd (the site\'s divider colour) across the full width. The gentlest edge.', css: '.site-header { border-bottom: 1px solid #ddd; }' },
  { id: 'b', name: 'B · Thin black line', text: '1px near-black. Crisper, matches the black text and menu.', css: '.site-header { border-bottom: 1px solid #111; }' },
  { id: 'c', name: 'C · Dark-red line', text: '2px dark red (#b20000), the colour of the page titles and buttons.', css: '.site-header { border-bottom: 2px solid #b20000; }' },
  { id: 'd', name: 'D · Soft shadow', text: 'No line, a soft shadow under the header so it appears to float above the page. Looks best when the header is sticky (phones, tablets).', css: '.site-header { box-shadow: 0 2px 10px rgba(0,0,0,.14); position: relative; z-index: 31; }' },
  { id: 'e', name: 'E · Logo-red line, thick', text: '3px bright logo red (#f00800), the boldest option; ties to the spiral.', css: '.site-header { border-bottom: 3px solid #f00800; }' },
];
---
<Base title="Header border review" lang="en" path="/design/header-border/" noindex wide>
  <h1>Header bottom border</h1>
  <p>Each frame shows the real Workshops page with the option applied. Scroll inside a frame to see how it behaves. On phones and tablets the header is sticky, so the edge also separates it from content scrolling underneath. Nothing here is applied to the site.</p>
  <p><strong>Recommendation:</strong> <strong>A</strong>, or <strong>D</strong> if you want it to feel like part of the page rather than a drawn line. Both stay neutral next to the red titles and the grey list. C is the one that connects most clearly to the titles.</p>
  {options.map((o) => (
    <section class="hb-var">
      <h2>{o.name}</h2>
      <p>{o.text}</p>
      <iframe class="hb-frame" src="/workshops/" title={o.name} data-css={o.css} loading="lazy"></iframe>
    </section>
  ))}
</Base>
<style is:global>
  .hb-var { margin: 2.5rem 0; }
  .hb-frame { width: 100%; height: 440px; border: 1px dashed #bbb; display: block; margin-top: 1rem; }
</style>
<script>
  document.querySelectorAll<HTMLIFrameElement>('.hb-frame').forEach((f) => {
    f.addEventListener('load', () => {
      const css = f.dataset.css;
      const doc = f.contentDocument;
      if (!css || !doc) return;
      const s = doc.createElement('style');
      s.textContent = css;
      doc.head.appendChild(s);
    });
  });
</script>
