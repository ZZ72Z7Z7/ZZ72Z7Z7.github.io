---
import Base from '../layouts/Base.astro';
import ScheduleItem from '../components/ScheduleItem.astro';
import Text from '../components/Text.astro';
import { getSchedule, getPage, groupByYear } from '../lib/content';
import { t, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const { upcoming, past } = await getSchedule();
const archive = groupByYear(past);
const note = await getPage('workshops-note', lang);
const empty = await getPage('workshops-empty', lang);
---
<Base title={ui.menu.workshops} lang={lang} path="/workshops/" section="workshops" wide>
  <h1 id="upcoming" class="center-title">{ui.upcomingWorkshops}</h1>
  {upcoming.length ? (
    <ul class="entries">{upcoming.map((e) => <ScheduleItem entry={e} lang={lang} card />)}</ul>
  ) : (
    <div class="center-text empty-list"><Text source={empty.entry.body} lang={lang} fallback={empty.fallback} notice={false} /></div>
  )}
  {upcoming.length > 0 && <div class="center-text"><Text source={note.entry.body} lang={lang} fallback={note.fallback} notice={false} /></div>}

  <section class="past-band">
  <h2 id="past" class="page-title center-title">{ui.pastWorkshops}</h2>
  <div class="year-list">
    {archive.map(([year, items]) => (
      <details class="year-acc">
        <summary><h3 class="year-title">{year}</h3></summary>
        <ul class="entries">{items.map((e) => <ScheduleItem entry={e} lang={lang} card noThumb level={4} />)}</ul>
      </details>
    ))}
  </div>
  </section>
</Base>
