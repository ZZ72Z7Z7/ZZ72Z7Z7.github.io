---
// Design review page: five quiet ways to frame the poem on white. Not part of the site: remove before launch.
// Each option is the real poem and signature, in the real home-page styles, with one framing touch added. No motion.
import Base from '../layouts/Base.astro';

const options = [
  { id: 'a', title: 'A · Two short red rules', note: 'A short red rule above and below, like a bookplate. The most restrained.' },
  { id: 'b', title: 'B · A quiet grey band', note: 'The poem sits on a very pale grey band that runs the full width, with fine lines top and bottom. It separates the poem from the page without any ornament.' },
  { id: 'c', title: 'C · A thin double frame', note: 'A fine black line with a second line just outside it, like a theatre bill. Formal and graphic.' },
  { id: 'd', title: 'D · A pale spiral behind the poem', note: 'The logo\'s spiral, huge and very faint, centred behind the poem. It ties the page to the logo and gives the white some depth. Fades to nothing at the edges.' },
  { id: 'e', title: 'E · Red corner marks', note: 'Four small red corner brackets, like crop marks on a photograph or a stage mark on the floor. Light and a little theatrical.' },
];
const stanzas = [
  ['stupefied by life, nature, beauty', 'and the mystery of the human condition'],
  ['I celebrate the sublime stupidity of Clowns', 'I long for the crazy wisdom of The Fool'],
  ['intelligence is limited', 'stupidity is infinite'],
  ['Clowning is very serious work', 'on how to be stupid'],
  ['to the delusional quest', 'for a mechanical artificial intelligence', 'I will respond with the daily practice', 'of embodied natural stupidity'],
];
---
<Base title="Poem frame review" lang="en" path="/design/poem-frame/" noindex>
  <Fragment slot="hero">
    <div class="rv-intro">
      <h1>Framing the poem</h1>
      <p>Five quiet touches that stop the poem floating on white. Each shows the real poem and signature at the real home-page size. Nothing moves. Resize the window or use a phone to see how each holds up.</p>
      <p><strong>Recommendation:</strong> <strong>D</strong>, the faint spiral. It is the only one that says something about him and the logo, and it adds depth without adding lines or boxes. <strong>A</strong> is the most restrained alternative, and <strong>B</strong> the safest.</p>
    </div>

    {options.map((o) => (
      <Fragment>
        <div class="rv-label"><strong>{o.title}.</strong> {o.note}</div>
        <section class={`split-poem fr fr-${o.id}`}>
          <div class="prose">
            <div class="poem-s">
              <p class="lead">I practice the freedom to be</p>
              <p class="word">stupidus</p>
              {stanzas.map((s) => <p>{s.map((l, i) => <Fragment>{i > 0 && <br />}{l}</Fragment>)}</p>)}
            </div>
            <div class="poem-sign">
              <p class="dots" aria-hidden="true">•••</p>
              <p class="sign-name">GIOVANNI FUSETTI</p>
              <p class="sign-roles">Artist, Natural Scientist, Pedagogue<br />Multi-Disciplinary Fool</p>
            </div>
          </div>
        </section>
      </Fragment>
    ))}
    <div class="rv-label rv-end">Each frame is built on the poem's own box, so the type still shrinks to fit and no line wraps, on phones too.</div>
  </Fragment>
</Base>

<style is:global>
  .rv-intro { max-width: var(--measure); margin: 0 auto; padding: 2rem var(--gutter) 1rem; }
  .rv-label { max-width: var(--measure); margin: 0 auto; padding: 1.5rem var(--gutter); color: var(--muted); }
  .rv-end { padding-bottom: 4rem; }
  .fr { position: relative; }

  /* A: two short red rules */
  .fr-a { padding-top: calc(var(--space-block) + 1rem); padding-bottom: calc(var(--space-block) + 1rem); }
  .fr-a::before, .fr-a::after { content: ""; position: absolute; left: 50%; width: 3rem; height: 3px; background: var(--red); transform: translateX(-50%); }
  .fr-a::before { top: calc(var(--space-block) - .5rem); }
  .fr-a::after { bottom: calc(var(--space-block) - .5rem); }

  /* B: pale grey band */
  .fr-b { background: #f3f3f3; border-block: 1px solid #ddd; }

  /* C: thin double frame */
  .fr-c { max-width: 44rem; margin: 3.5rem auto; padding: 3.5rem clamp(1.5rem, 5vw, 3rem); border: 1px solid var(--text); box-shadow: 0 0 0 6px #fff, 0 0 0 7px var(--text); width: calc(100% - 2 * var(--gutter) - 14px); }

