---
// Design review page (1c Layout system). Local only.
// The real site pages are shown in a frame; the controls change the layout settings inside the frame.
import Base from '../layouts/Base.astro';
---
<Base title="Layout review" lang="en" path="/design/layout/" noindex wide>
  <h1>1c · Layout system</h1>
  <p>The real pages are shown below at the width you pick. Change the settings and the page updates. The first value in each list is what the site uses now. The three presets set everything at once.</p>

  <div class="bar">
    <fieldset>
      <legend>Page</legend>
      <select id="page">
        <option value="/workshops/">Workshops</option>
        <option value="/workshops/red-nose-intensive/">One workshop</option>
        <option value="/events/">Events</option>
        <option value="/2022/02/04/joan-schirle/">Blog post (poem)</option>
        <option value="/giovanni-fusetti/">About</option>
        <option value="/blog/">Blog list</option>
        <option value="/contact/">Contact</option>
        <option value="/">Home</option>
      </select>
    </fieldset>
    <fieldset>
      <legend>Screen width</legend>
      <div class="btns" id="widths">
        <button type="button" data-w="375">Phone 375</button>
        <button type="button" data-w="768">Tablet 768</button>
        <button type="button" data-w="1024">Small laptop 1024</button>
        <button type="button" data-w="1440">Desktop 1440</button>
      </div>
    </fieldset>
    <fieldset>
      <legend>Preset</legend>
      <div class="btns" id="presets">
        <button type="button" data-p="compact">Compact</button>
        <button type="button" data-p="current">Current</button>
        <button type="button" data-p="airy">Airy</button>
      </div>
    </fieldset>
  </div>

  <form class="ctl" onsubmit="return false">
    <label>Text column width
      <select data-var="--measure"><option value="44rem">44 rem, about 75 characters (now)</option><option value="38rem">38 rem</option><option value="50rem">50 rem</option><option value="56rem">56 rem</option></select>
    </label>
    <label>Wide width (header, events, galleries)
      <select data-var="--wide"><option value="64rem">64 rem (now)</option><option value="56rem">56 rem</option><option value="72rem">72 rem</option><option value="80rem">80 rem</option></select>
    </label>
    <label>Side margin on phones
      <select data-var="--gutter"><option value="1rem">16 px (now)</option><option value="1.25rem">20 px</option><option value="1.5rem">24 px</option><option value="2rem">32 px</option></select>
    </label>
    <label>Space above the page title
      <select data-var="--page-top"><option value="2rem">32 px (now)</option><option value="1.25rem">20 px</option><option value="3rem">48 px</option><option value="4rem">64 px</option></select>
    </label>
    <label>Space between sections
      <select data-var="--space-section"><option value="2rem">32 px (now)</option><option value="1.5rem">24 px</option><option value="2.75rem">44 px</option><option value="3.5rem">56 px</option></select>
    </label>
    <label>Space between paragraphs
      <select data-var="--space-p"><option value="1rem">16 px (now)</option><option value=".75rem">12 px</option><option value="1.25rem">20 px</option><option value="1.5rem">24 px</option></select>
    </label>
    <label>Space below the last line of every page
      <select data-var="--space-end"><option value="7.5rem">120 px (now)</option><option value="5rem">80 px</option><option value="10rem">160 px</option><option value="3.5rem">56 px</option></select>
    </label>
    <label>Space inside list entries (workshops, posts)
      <select data-var="--space-entry"><option value="1rem">16 px (now)</option><option value=".7rem">11 px</option><option value="1.4rem">22 px</option><option value="1.9rem">30 px</option></select>
    </label>
  </form>

  <div class="stage">
    <iframe id="frame" title="Site preview" src="/workshops/" style="width: 1024px"></iframe>
  </div>

  <h2>Breakpoints (when the layout changes)</h2>
  <p>These are fixed points, so try them with the width buttons above rather than the dropdowns:</p>
  <ul>
    <li><strong>Below 1024 px (64 rem):</strong> the menu becomes the three-bar button (phones and tablets, including iPads in portrait; iPads in landscape, at 1024 px, show the full menu). The logo and its button always share one row.</li>
    <li><strong>Below 640 px (40 rem):</strong> the phone type sizes apply (headings step down), the About page text moves from centred to left-aligned, and event details stack.</li>
    <li>The landing page (Home) has its own behaviour (the pinned photo and fading poem) and is not affected by the spacing controls here.</li>
    <li>Say if you want either point moved. For example, tablets in landscape (1024) could keep the button.</li>
  </ul>

  <script is:inline>
    var frame = document.getElementById('frame');
    var vars = {};
    var presets = {
      compact: { '--measure': '40rem', '--wide': '60rem', '--gutter': '1rem', '--page-top': '1.25rem', '--space-section': '1.5rem', '--space-p': '.75rem', '--space-entry': '.7rem', '--space-end': '5rem' },
      current: { '--measure': '44rem', '--wide': '64rem', '--gutter': '1rem', '--page-top': '2rem', '--space-section': '2rem', '--space-p': '1rem', '--space-entry': '1rem', '--space-end': '7.5rem' },
      airy: { '--measure': '44rem', '--wide': '72rem', '--gutter': '1.5rem', '--page-top': '4rem', '--space-section': '3.5rem', '--space-p': '1.5rem', '--space-entry': '1.9rem', '--space-end': '10rem' }
    };
    function apply() {
      try {
        var root = frame.contentDocument.documentElement;
        Object.keys(vars).forEach(function (k) { root.style.setProperty(k, vars[k]); });
      } catch (e) {}
    }
    document.querySelectorAll('select[data-var]').forEach(function (s) {
      vars[s.dataset.var] = s.value;
      s.addEventListener('change', function () { vars[s.dataset.var] = s.value; apply(); });
    });
    frame.addEventListener('load', apply);
    document.getElementById('page').addEventListener('change', function (e) { frame.src = e.target.value; });
    document.querySelectorAll('#widths button').forEach(function (b) {
      b.addEventListener('click', function () { frame.style.width = b.dataset.w + 'px'; });
    });
    document.querySelectorAll('#presets button').forEach(function (b) {
      b.addEventListener('click', function () {
        var p = presets[b.dataset.p];
        Object.keys(p).forEach(function (k) {
          vars[k] = p[k];
          var sel = document.querySelector('select[data-var="' + k + '"]');
          if (sel) { if (![].some.call(sel.options, function (o) { return o.value === p[k]; })) sel.add(new Option(p[k], p[k])); sel.value = p[k]; }
        });
        apply();
      });
    });
  </script>

  <style>
    .bar { display: flex; flex-wrap: wrap; gap: 1rem 2rem; margin-bottom: 1.25rem; }
    fieldset { border: 0; padding: 0; margin: 0; }
    legend { font-size: .85rem; font-weight: 600; margin-bottom: .35rem; padding: 0; }
    .btns { display: flex; flex-wrap: wrap; gap: .4rem; }
    .btns button { font: inherit; font-size: .9rem; padding: .4rem .8rem; border: 1px solid var(--muted); background: var(--bg); color: var(--text); cursor: pointer; font-weight: 500; }
    .btns button:hover { border-color: var(--red-text); color: var(--red-text); }
    select { font: inherit; padding: .4rem .5rem; border: 1px solid var(--muted); background: var(--bg); color: var(--text); }
    .ctl { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: .8rem 1.25rem; max-width: none; margin: 0 0 1.5rem; }
    .ctl label { font-size: .88rem; }
    .stage { background: #e9e9e9; padding: 1rem; overflow-x: auto; border: 1px solid var(--line); }
    iframe { display: block; height: 760px; border: 0; background: #fff; margin: 0 auto; max-width: none; }
  </style>
</Base>
